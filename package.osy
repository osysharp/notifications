// Osysharp.Notifications — telling a person that something needs them: in the app (a bell with a count, a list with
// read and unread, mark all read) and by mail when they have not seen it (a daily digest, or a mention at once — their
// own choice), in THEIR language.
//
// The kit never knows WHAT it is telling somebody about — a ticket, an approval, a request, a document. A notification
// is about any record the app keeps (an `Entity`), and what that record is called, where it opens and who may read it
// are the record's own facts — its `[Title]`, the page that `[Opens]` it, its `security { }` — so the app writes no
// class to tell the kit them. WHAT happened is an EVENT — the app's own or any kit's — which carries its own sentence:
//     [Event("Customer wrote again")]
//     public sealed class CustomerWrote {
//       public Ticket Ticket;
//       public override string Sentence() { return $"{Ticket.Customer.DisplayName} wrote again."; }   // said when READ
//     }
// and the app tells people with one call, from anywhere — a page, a function, a workflow body, an `[On]` handler:
//     Notify(person, new CustomerWrote { Ticket = t });
//     [On] void TellReviewers(ArticleSentForReview e) { NotifyAll(reviewers, e); }   // a kit's event, as it is
//
// ⚑ NOBODY IS TOLD ABOUT WHAT THEY MAY NOT READ. Delivery asks `Records.MayRead(recipient, about)` — the recipient's
//   OWN rules — after the caller's commit; the bell reads the record as its reader, and a mail asks again for all of a
//   person's notifications at once. A notification that fails it is withheld, recorded with why, and never shown.
//   SECURITY-INVARIANT(notifications-only-about-what-the-recipient-may-read).
//
// ⚑ DELIVERY IS DURABLE AND SAID ONCE. Each notification is a row a workflow delivers after the commit that wrote it
//   (a throw is retried); one about the same thing (its key) that is still unread is not a second row — the unread one
//   moves to the top, counting how often. A mail is sent once per notification.
//
// ⚑ THE EVENT, NOT ITS SENTENCE (D-RTL2 Q2). A notification keeps the event itself and says it with the event's own
//   `Sentence()` when it is read — the bell in the reader's language, the mail in the recipient's — with the event's
//   records read as the reader may read them.
//
// ⚑ THE APP SAYS ONE THING — who has a bell, and preferences:
//     policy ReceivesNotifications => IsAgent;
package Osysharp.Notifications {
  version     "1.1.0";
  minPlatform "0.9.0";
  summary     "telling a person something needs them — a bell with a live count and a list (read and unread, mark all read), a daily mail digest of what they have not seen or a mention mailed at once (their own choice, in their own language), delivered durably after the commit, deduplicated while unread, and never about a record the recipient may not read under their own security.";
  model "model/**/*.osy";
  // The personal data its own fields hold (`[Classification(Personal.X)]`): what happened, which can name people.
  personal Content;
  use Osysharp.Identity@0;
  // Delivery and the hourly sweep are workflows.
  use Osysharp.Workflow;
  // What is mailed goes through the app's mail, in the frame its other mail has.
  use Osysharp.Mail@0;
  use Osysharp.EmailTemplates@0;
  // The daily digest goes out in the team's morning — on the app's clock.
  use Osysharp.Clock@0;
  // The bell, the list and the preferences page — themed by the app.
  use Osysharp.Ui;
  tests "tests";
}
